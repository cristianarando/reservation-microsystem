# Local SQLite database (default for rapid development)
DATABASE_URL="file:./dev.db"

# Cryptographic HMAC-SHA256 secret used to sign session cookies (Generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-32-byte-random-hex-secret-in-production"

# Number of trusted reverse-proxy hops in front of Next.js (1 for direct Nginx/Caddy, 0 if directly exposed)
TRUSTED_PROXY_HOPS="1"

# Primary public canonical URL used for OAuth redirects, Web Push VAPID subject, and SEO/OG tags
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
# Optional SEO/Open Graph URL override (falls back to NEXT_PUBLIC_APP_URL when omitted)
NEXT_PUBLIC_SITE_URL=""

# Optional Google Search Console verification meta tag token
GOOGLE_SITE_VERIFICATION=""

# Google OAuth 2.0 Credentials (https://console.cloud.google.com)
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Web Push (VAPID) keys. If left empty, a stable P-256 keypair is derived automatically from SESSION_SECRET.
# Setting dedicated VAPID keys in production is recommended so rotating SESSION_SECRET preserves browser subscriptions.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
PUSH_DISPATCH_PAUSED="false"
