// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessSettings {
  id                     Int      @id @default(1)
  name                   String   @default("Mi Negocio")
  tagline                String   @default("Reserva tu cita en segundos")
  logoUrl                String?
  addressText            String   @default("Av. Principal 123, Bolivia")
  googleMapsUrl          String   @default("https://maps.google.com")
  phoneWhatsapp          String   @default("+59170000000")
  currencySymbol         String   @default("Bs")
  staffLabel             String   @default("Especialista") // Dynamic terminology: "Especialista" | "Doctor(a)" | "Barbero"
  slotStepMin            Int      @default(30)            // Grid interval: 15, 20, 30 min
  bookingHorizonDays     Int      @default(7)             // Booking horizon limit (e.g. 7 days ahead)
  minLeadTimeMinutes     Int      @default(30)            // Minimum lead time before appointment start
  maxActiveBookings      Int      @default(2)             // Anti-hoarding limit: max active upcoming bookings
  minCancelNoticeHours   Int      @default(6)             // Advance notice required for customer cancellation
  themePrimaryHex        String   @default("#1F1F23")     // Primary theme brand color
  themeSurfaceHex        String   @default("#9FA0A6")     // Secondary surface color
  updatedAt              DateTime @updatedAt
}

model User {
  id                   String             @id @default(cuid())
  googleId             String?            @unique
  email                String             @unique
  passwordHash         String?            // Bcrypt-hashed password for secure email login
  name                 String
  avatarUrl            String?
  phone                String?            // Required contact phone number
  role                 String             @default("CUSTOMER") // "CUSTOMER" | "PROVIDER" | "ADMIN"
  isBlocked            Boolean            @default(false)      // Anti-troll lock: blocked due to no-shows
  noShowCount          Int                @default(0)
  completedCount       Int                @default(0)
  adminNotes           String?
  sessionVersion       Int                @default(1)          // Incremented to revoke prior sessions on privilege/credential changes
  pendingStaffUpgrade  Boolean            @default(false)      // True when a pre-existing customer account is invited as staff pending verification
  staffInviteTokenHash String?            // SHA-256 hash of pending staff invitation token
  staffInviteExpiresAt DateTime?          // Expiration timestamp for staff invitation token
  notifyAllStaff       Boolean            @default(false)      // Explicit ADMIN preference to receive alerts for all staff vs own agenda
  createdAt            DateTime           @default(now())

  staffProfile         StaffProfile?
  appointments         Appointment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  pushDeliveries       PushDelivery[]
}

model StaffProfile {
  id                  String         @id @default(cuid())
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id])
  displayName         String
  specialtyTitle      String         @default("Especialista")
  avatarUrl           String?
  customHorizonDays   Int?           // Specialist custom horizon override (days)
  customLeadTimeMin   Int?           // Specialist custom lead time override (minutes)
  isActive            Boolean        @default(true)
  sortOrder           Int            @default(0)

  services            StaffService[]
  workingShifts       WorkingShift[]
  timeOffs            TimeOff[]
  appointments        Appointment[]
}

model Service {
  id             String         @id @default(cuid())
  name           String
  description    String?
  durationMin    Int            @default(30) // Duration: 15, 30, 45, 60, 90 min
  bufferAfterMin Int            @default(0)  // Turnaround buffer time post-appointment
  price          Float          @default(25.0)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)

  staff          StaffService[]
  appointments   Appointment[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingShift {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int          // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime String       // Format "HH:mm" (e.g. "07:00", "14:30", "01:00")
  endTime   String       // Format "HH:mm" (e.g. "13:00", "19:30", "06:00")

  @@index([staffId, dayOfWeek])
}

model TimeOff {
  id         String       @id @default(cuid())
  staffId    String
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  type       String       @default("CUSTOM_BLOCK") // "LATE_START" | "EARLY_LEAVE" | "FULL_DAY_OFF" | "CUSTOM_BLOCK" | "VACATION"
  reason     String?      // Internal contextual reason e.g. "Medical Emergency", "Conference"
  publicNote String?      // Optional public-approved message shown to visitors
  createdAt  DateTime     @default(now())

  @@index([staffId, startAt, endAt])
}

model Appointment {
  id                  String       @id @default(cuid())
  customerId          String
  customer            User         @relation(fields: [customerId], references: [id])
  staffId             String
  staff               StaffProfile @relation(fields: [staffId], references: [id])
  serviceId           String
  service             Service      @relation(fields: [serviceId], references: [id])

  startAt             DateTime
  endAt               DateTime     // startAt + durationMin + bufferAfterMin
  status              String       @default("CONFIRMED") 
  // Statuses: "CONFIRMED" | "RESCHEDULED_BY_STAFF" | "COMPLETED" | "CANCELLED" | "NO_SHOW" | "NO_SHOW_ARCHIVED"

  previousStartAt     DateTime?    // Original timestamp if rescheduled by staff
  staffMoveReason     String?      // Operational note explaining rescheduling
  allowFreeCancel     Boolean      @default(false) // Penalty-free cancel if modified by staff
  rescheduleVersion   Int          @default(0)     // Monotonic counter incremented on each reschedule
  cancelledBy         String?      // "STAFF" | "CUSTOMER" | "ADMIN"
  cancelledByUserId   String?      // Actor user ID that performed cancellation

  priceSnapshot       Float
  customerNotes       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([staffId, startAt, endAt])
  @@index([customerId, status, startAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  eventKey      String?  // Deterministic key preventing duplicate internal notifications across retries
  title         String
  message       String
  type          String   // "APPOINTMENT_MOVED" | "APPOINTMENT_CANCELLED" | "APPOINTMENT_CANCELLED_BY_CUSTOMER" | "NEW_APPOINTMENT" | "REMINDER"
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, isRead])
  @@index([eventKey])
}

model PushSubscription {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String         @unique
  p256dh          String
  auth            String
  userAgent       String?
  status          String         @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "REVOKED" | "UNSUBSCRIBED"
  lastConfirmedAt DateTime       @default(now())
  lastSuccessAt   DateTime?
  lastErrorCode   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries      PushDelivery[]

  @@index([userId, status])
}

model PushDelivery {
  id              String           @id @default(cuid())
  eventKey        String           // Unique logical event identifier per appointment/transition/version
  eventType       String           // "APPOINTMENT_CREATED" | "APPOINTMENT_CANCELLED" | "MASS_CANCELLATION" | "CUSTOMER_CANCELLED" | "APPOINTMENT_RESCHEDULED"
  appointmentId   String?
  notificationId  String?
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  title           String           // Generic lock-screen safe title
  body            String           // Generic lock-screen safe body
  targetPath      String           // Internal relative path opened on click
  tag             String           // Deduplication tag for Service Worker showNotification
  status          String           @default("PENDING") // "PENDING" | "PROCESSING" | "DELIVERED" | "FAILED_PERMANENT" | "EXPIRED" | "SKIPPED"
  attempts        Int              @default(0)
  maxAttempts     Int              @default(5)
  nextAttemptAt   DateTime         @default(now())
  claimedUntil    DateTime?
  expiresAt       DateTime
  lastStatusCode  Int?
  lastError       String?
  deliveredAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([eventKey, recipientUserId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@index([recipientUserId, status])
}
